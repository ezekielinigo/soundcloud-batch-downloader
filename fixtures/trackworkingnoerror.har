Interest\",\"PCenterConsentText\":\"Consent\",\"PCenterVendorListFilterAria\":\"Filter\",\"PCenterCookieListFilterAria\":\"Filter\",\"BInitialFocus\":true,\"BInitialFocusLinkAndButton\":false,\"NewVendorsInactiveEnabled\":false,\"PCenterFilterAppliedAria\":\"Applied\",\"PCenterFilterClearedAria\":\"Filters Cleared\",\"PCenterVendorListScreenReader\":\"Vendor Details button opens Vendor List menu\",\"PCenterCookieSearchAriaLabel\":\"Cookie list search\",\"PCenterVendorSearchAriaLabel\":\"Vendor list search\",\"PCenterVendorListTitle\":null,\"PCenterVendorListLinkText\":\"\",\"PCenterVendorListLinkAriaLabel\":\"\",\"IsShowAlwaysActiveText\":true,\"PCenterUserIdTitleText\":\"\",\"PCenterUserIdDescriptionText\":\"\",\"PCenterUserIdTimestampTitleText\":\"\",\"PCenterUserIdNotYetConsentedText\":\"\",\"BImprintLinkScreenReader\":\"Privacy policy, opens in a new tab\",\"BShowImprintLink\":false,\"PCenterImprintLinkScreenReader\":\"\",\"PCenterImprintLinkText\":\"\",\"PCenterImprintLinkUrl\":\"\",\"PCCategoryStyle\":\"Toggle\",\"PCVSEnable\":false,\"PCVSOptOut\":false,\"PCVSCategoryView\":false,\"PCVSExpandCategory\":false,\"PCVSExpandGroup\":false,\"PCVSListTitle\":null,\"PCVSNameText\":null,\"PCVSParentCompanyText\":null,\"PCVSAddressText\":null,\"PCVSDefaultCategoryText\":null,\"PCVSDefaultDescriptionText\":null,\"PCVSDPOEmailText\":null,\"PCVSDPOLinkText\":null,\"PCVSPrivacyPolicyLinkText\":null,\"PCVSCookiePolicyLinkText\":null,\"PCVSOptOutLinkText\":null,\"PCVSLegalBasisText\":null,\"PCVSAllowAllText\":null,\"BShowOptOutSignal\":false,\"BOptOutSignalText\":\"\",\"PCShowOptOutSignal\":false,\"PCOptOutSignalText\":\"\",\"BOptOutSignalTextAfterConsent\":\"\",\"PCOptOutSignalTextAfterConsent\":\"\",\"PCShowDoubleOptInSignal\":false,\"PCDoubleOptInSignalText\":\"\",\"PCDoubleOptInSignalDescription\":\"\",\"PCDoubleOptInSignalCancelText\":\"\",\"PCDoubleOptInSignalConfirmText\":\"\",\"PCHostNotFound\":\"did not match any Hosts\",\"PCVendorNotFound\":\"did not match any Vendors\",\"PCTechNotFound\":\"did not match any Technologies\",\"PCTrackingTechTitle\":\"Technology List\",\"PCTechDetailsText\":\"Technologies List\",\"PCTechDetailsAriaLabel\":\"Technologies List button opens Tracking Tech list menu\",\"PCShowTrackingTech\":false,\"PCCookiesLabel\":\"Cookies\",\"PCLocalStorageLabel\":\"Local Storage[s]\",\"PCSessionStorageLabel\":\"Session Storage[s]\",\"PCLocalStorageDurationText\":\"Permanent\",\"PCSessionStorageDurationText\":\"Session\",\"BRegionAriaLabel\":\"Cookie banner - Keep the scene alive & your vibe fresh\",\"BannerAriaLabel\":\"\",\"BannerOptOutSignalNotHonoredText\":\"Opt-out preference signal not honored\",\"PCenterOptOutSignalNotHonoredText\":\"Opt-out preference signal not honored\",\"PCRegionAriaLabel\":\"Preference center\",\"IsGPPEnabled\":false,\"IsGPPKnownChildApplicable\":false,\"IsGPPDataProcessingApplicable\":false,\"GPPPurposes\":{\"SaleOptOutCID\":\"\",\"SharingOptOutCID\":\"\",\"PersonalDataCID\":\"\",\"KnownChildSellPICID\":\"\",\"KnownChildProcessCID\":\"\",\"KnownChildSharePICID\":\"\",\"SensitivePICID\":\"\",\"TargetedAdvertisingOptOutCID\":\"\",\"SensitiveSICID\":\"\",\"GeolocationCID\":\"\",\"RREPInfoCID\":\"\",\"CommunicationCID\":\"\",\"GeneticCID\":\"\",\"BiometricCID\":\"\",\"HealthCID\":\"\",\"SexualOrientationCID\":\"\",\"RaceCID\":\"\",\"ReligionCID\":\"\",\"ImmigrationCID\":\"\",\"PDCAboveAgeCID\":\"\",\"PDCBelowAgeCID\":\"\",\"UnionMembershipCID\":\"\",\"KnownChildProcessBelowAge13CID\":\"\",\"KnownChildProcessBetweenAge13To16CID\":\"\",\"KnownChildProcessBetweenAge16To18CID\":\"\",\"KnownChildSellAge16To18CID\":\"\",\"KnownChildProcessAge16To18CID\":\"\",\"KnownChildSellAge16To17CID\":\"\",\"KnownChildProcessAge16To17CID\":\"\",\"TransgenderCID\":\"\",\"NationalOriginCID\":\"\",\"CrimeVictimCID\":\"\",\"ConsumerHealthCID\":\"\"},\"IsMSPAEnabled\":false,\"MSPAOptionMode\":\"\",\"UseGPPUSNational\":false,\"PCVListDataDeclarationText\":\"Data Declaration\",\"PCVListDataRetentionText\":\"Data Retention\",\"PCVListStdRetentionText\":\"Standard Retention\",\"PCVendorsCountText\":\"[VENDOR_NUMBER] partners can use this purpose\",\"PCVendorsCountFeatureText\":\"[VENDOR_NUMBER] partners can use this feature\",\"PCVendorsCountSpcFeatureText\":\"[VENDOR_NUMBER] partners can use this special feature\",\"PCVendorsCountSpcPurposeText\":\"[VENDOR_NUMBER] partners can use this special purpose\",\"IABDataCategories\":[{\"Id\":1,\"Name\":\"IP addresses\",\"Description\":\"Your IP address is a number assigned by your Internet Service Provider to any Internet connection. It is not always specific to your device and is not always a stable identifier. It is used to route information on the Internet and display online content (including ads) on your connected device.\",\"CustomGroupId\":\"IAB2V2DC_1\"},{\"Id\":8,\"Name\":\"Non-precise location data\",\"Description\":\"An approximation of your location, expressed as an area with a radius of at least 500 meters. Your approximate location can be deduced from e.g. the IP address of your connection.\",\"CustomGroupId\":\"IAB2V2DC_8\"},{\"Id\":11,\"Name\":\"Privacy choices\",\"Description\":\"Your preferences regarding the processing of your data, based on the information you have received.\",\"CustomGroupId\":\"IAB2V2DC_11\"},{\"Id\":3,\"Name\":\"Device identifiers\",\"Description\":\"A device identifier is a unique string of characters assigned to your device or browser by means of a cookie or other storage technologies. It may be created or accessed to recognise your device e.g. across web pages from the same site or across multiple sites or apps.\",\"CustomGroupId\":\"IAB2V2DC_3\"},{\"Id\":4,\"Name\":\"Probabilistic identifiers\",\"Description\":\"A probabilistic identifier can be created by combining characteristics associated with your device (the type of browser or operating system used) and the IP address of the Internet connection. If you give your agreement, additional characteristics (e.g. the installed font or screen resolution) can also be combined to improve precision of the probabilistic identifier.Such an identifier is considered \\\"probabilistic\\\" because several devices can share the same characteristics and Internet connection. It may be used to recognise your device across e.g. web pages from the same site or across multiple sites or apps.\",\"CustomGroupId\":\"IAB2V2DC_4\"},{\"Id\":6,\"Name\":\"Browsing and interaction data\",\"Description\":\"Your online activity such as the websites you visit, apps you are using, the content you search for on this service,  or your interactions with content or ads, such as the number of times you have seen a specific content or ad or whether you clicked on it.\",\"CustomGroupId\":\"IAB2V2DC_6\"},{\"Id\":7,\"Name\":\"User-provided data\",\"Description\":\"The information you may have provided by way of declaration via a form (e.g. feedback, a comment) or when creating an account (e.g. your age, your occupation).\",\"CustomGroupId\":\"IAB2V2DC_7\"},{\"Id\":5,\"Name\":\"Authentication-derived identifiers\",\"Description\":\"Where an identifier is created on the basis of authentication data, such as contact details associated with online accounts you have created on websites or apps (e.g. e-mail address, phone number) or customer identifiers (e.g. identifier provided by your telecom operator), that identifier may be used to recognise you across websites, apps and devices when you are logged-in with the same contact details.\",\"CustomGroupId\":\"IAB2V2DC_5\"},{\"Id\":10,\"Name\":\"Users’ profiles\",\"Description\":\"Certain characteristics (e.g. your possible interests, your purchase intentions, your consumer profile) may be inferred or modeled from your previous online activity (e.g. the content you viewed or the service you used, your time spent on various online content and services) or the information you have provided (e.g. your age, your occupation).\",\"CustomGroupId\":\"IAB2V2DC_10\"},{\"Id\":2,\"Name\":\"Device characteristics\",\"Description\":\"Technical characteristics about the device you are using that are not unique to you, such as the language, the time zone or the operating system.\",\"CustomGroupId\":\"IAB2V2DC_2\"},{\"Id\":9,\"Name\":\"Precise location data\",\"Description\":\"Your precise location within a radius of less than 500 meters based on your GPS coordinates. It may be used only with your acceptance.\",\"CustomGroupId\":\"IAB2V2DC_9\"}],\"IABGroupsPrefixData\":{\"purpose\":\"IAB2V2\",\"specialPurpose\":\"ISP2V2\",\"feature\":\"IFE2V2\",\"specialFeature\":\"ISF2V2\",\"stack\":\"V2STACK\"},\"UseNonStandardStacks\":false,\"IsRequireSignatureEnabled\":false,\"RequireSignatureCID\":\"\",\"PCRequireSignatureFieldLabel\":\"Email\",\"PCRequireSignatureHeaderText\":\"Authorization Needed\",\"PCRequireSignatureHeaderDesc\":\"Additional consent authorization is needed for the following reason:\",\"PCRequireSignatureConfirmBtnText\":\"Confirm\",\"PCRequireSignatureRejectBtnText\":\"Reject\",\"PCRequireSignatureHelpText\":\"This field is required to consent to this category.\",\"MCMData\":{\"Enabled\":false,\"StorageTypes\":{\"ad_storage\":\"C0004\",\"analytics_storage\":\"\"}},\"ACMData\":{\"Enabled\":false,\"StorageTypes\":{\"ad_storage\":\"\",\"user_data\":\"\"}},\"BannerBPOFirstPosition\":\"ACCEPT_ALL\",\"BannerBPOSecondPosition\":\"REJECT_ALL\",\"BannerBPOThirdPosition\":\"COOKIE_SETTINGS\",\"BannerBPOFourthPosition\":null,\"PCBPOFirstPosition\":\"ACCEPT_ALL\",\"PCBPOSecondPosition\":\"REJECT_ALL\",\"PCBPOThirdPosition\":\"SAVE_PREFERENCE\",\"PCCookieListFiltersText\":\"Cookie List Filters\",\"CanGenerateNotGivenReceipts\":true,\"AmazonConsentSrcUrl\":\"https://c.amazon-adsystem.com/aat/amzn-consent.js\",\"PCenterApplyFiltersAriaLabel\":\"Apply filters\",\"PCenterCancelFilterAriaLabel\":\"Cancel filter application\",\"PCenterClearFiltersAriaLabel\":\"Clear filters\",\"PCenterToggleActiveColor\":\"#468254\",\"PCenterToggleInActiveColor\":\"#767676\",\"PCenterCookieCategoriesAriaLabel\":\"Cookie Categories\",\"GPCOptOutNoteText\":\"Opted out due to GPC signal.\",\"DNTOptOutNoteText\":\"Opted out due to DNT signal.\",\"ATTOptOutNoteText\":\"Opted out due to ATT signal.\"},\"CommonData\":{\"pcenterContinueWoAcceptLinkColor\":\"#696969\",\"IabThirdPartyCookieUrl\":\"cookies.onetrust.mgr.consensu.org\",\"OptanonHideAcceptButton\":\"\",\"OptanonStyle\":\"modern\",\"OptanonStaticContentLocation\":\"\",\"BannerCustomCSS\":\"/* @@@ Custom GDPR banner css: start @@@ */\\n/* Please refer to v2/docs/infrastructure/onetrust.md */\\n.ot-floating-button {\\n  display: none;\\n}\\n\\n\\n#onetrust-consent-sdk #onetrust-banner-sdk {\\n  background-color: #f3f3f3;\\n  min-height: 120px;\\n  box-shadow: none;\\n  border: 0;\\n}\\n\\n#onetrust-consent-sdk #onetrust-banner-sdk:focus {\\n  outline: none;\\n}\\n\\n@media only screen and (max-width: 330px) {\\n  #onetrust-consent-sdk #onetrust-banner-sdk.otFlat.ot-iab-2 {\\n    max-height: none;\\n  }\\n}\\n\\n#onetrust-banner-sdk > div {\\n  flex-grow: 1;\\n}\\n\\n#onetrust-consent-sdk #onetrust-banner-sdk .ot-sdk-row {\\n  display: flex;\\n  max-width: 1240px;\\n  margin: auto;\\n  padding-left: 30px;\\n  padding-right: 30px;\\n  padding-top: 40px;\\n  padding-bottom: 30px;\\n}\\n\\n@media only screen and (max-width: 1239px) {\\n  #onetrust-consent-sdk #onetrust-banner-sdk .ot-sdk-row {\\n    max-width: 1080px;\\n  }\\n}\\n\\n#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-policy {\\n  margin: 0;\\n}\\n#onetrust-consent-sdk\\n  #onetrust-banner-sdk\\n  #onetrust-policy\\n  #onetrust-policy-title,\\n#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-policy h3 {\\n  color: #000000;\\n  font-size: 16px;\\n  font-family: Interstate, \\\"Lucida Grande\\\", \\\"Lucida Sans Unicode\\\", \\\"Lucida Sans\\\",\\n    Garuda, Verdana, Tahoma, sans-serif;\\n}\\n@media only screen and (max-width: 330px) {\\n  #onetrust-consent-sdk\\n    #onetrust-banner-sdk\\n    #onetrust-policy\\n    #onetrust-policy-title,\\n  #onetrust-consent-sdk #onetrust-banner-sdk #onetrust-policy h3 {\\n    font-size: 14px;\\n  }\\n}\\n\\n#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-policy-text {\\n  margin-bottom: 0;\\n}\\n\\n#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-policy-text,\\n#onetrust-consent-sdk #onetrust-banner-sdk .ot-dpd-desc,\\n#onetrust-consent-sdk #onetrust-banner-sdk .ot-b-addl-desc {\\n  color: #000000;\\n  font-family: Interstate, \\\"Lucida Grande\\\", \\\"Lucida Sans Unicode\\\", \\\"Lucida Sans\\\",\\n    Garuda, Verdana, Tahoma, sans-serif;\\n  font-weight: 100;\\n  font-size: 14px;\\n  line-height: 20px;\\n}\\n@media only screen and (max-width: 330px) {\\n  #onetrust-consent-sdk #onetrust-banner-sdk #onetrust-policy-text,\\n  #onetrust-consent-sdk #onetrust-banner-sdk .ot-dpd-desc,\\n  #onetrust-consent-sdk #onetrust-banner-sdk .ot-b-addl-desc {\\n    font-size: 12px;\\n  }\\n}\\n\\n/* Override the position absolute */\\n#onetrust-consent-sdk\\n  #onetrust-banner-sdk:not(.ot-iab-2).vertical-align-content\\n  #onetrust-consent-sdk\\n  #onetrust-button-group-parent {\\n  position: static;\\n  transform: none;\\n  margin-left: 20px;\\n}\\n\\n#onetrust-consent-sdk\\n  #onetrust-banner-sdk.ot-buttons-fw:not(.ot-iab-2)\\n  #onetrust-button-group,\\n#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-button-group {\\n  display: flex;\\n  justify-content: flex-end;\\n  margin-right: 0;\\n  margin-top: 0;\\n  width: auto;\\n}\\n#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-button-group {\\n  flex-direction: column;\\n}\\n\\n#onetrust-consent-sdk\\n  #onetrust-banner-sdk:not(.ot-iab-2)\\n  #onetrust-button-group-parent,\\n#onetrust-consent-sdk\\n  #onetrust-banner-sdk.ot-buttons-fw:not(.ot-iab-2)\\n  #onetrust-button-group-parent,\\n#onetrust-consent-sdk\\n  #onetrust-banner-sdk.vertical-align-content\\n  #onetrust-button-group-parent {\\n  align-self: flex-end;\\n  flex-grow: 0;\\n  flex-shrink: 0;\\n  margin: auto;\\n  max-width: 45%;\\n  padding-left: 0;\\n  padding-right: 0;\\n  position: static;\\n  transform: none;\\n  width: unset;\\n}\\n\\n/* Initialising the browser will add some weird classes that I need to override */\\n#onetrust-consent-sdk\\n  #onetrust-banner-sdk.ot-buttons-fw:not(.ot-iab-2)\\n  #onetrust-button-group\\n  button,\\n#onetrust-consent-sdk\\n  #onetrust-banner-sdk.ot-buttons-fw:not(.ot-iab-2)\\n  #onetrust-button-group\\n  button:last-of-type {\\n  width: auto;\\n  margin-top: 0;\\n  margin-bottom: 0;\\n}\\n\\n#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-accept-btn-handler,\\n#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-pc-btn-handler,\\n#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-reject-all-handler {\\n  border: 2px solid #f3f3f3; /* same colour as bg to act as padding between focus border and button */\\n  border-radius: 8px; /* divided by border width to make border radius 4 */\\n  font-family: Interstate, \\\"Lucida Grande\\\", \\\"Lucida Sans Unicode\\\", \\\"Lucida Sans\\\",\\n    Garuda, Verdana, Tahoma, sans-serif;\\n  font-size: 14px;\\n  font-weight: normal;\\n  line-height: 20px;\\n  margin-top: 0;\\n  margin-bottom: 0;\\n  margin-right: 0;\\n  padding: 12px 30px;\\n}\\n\\n#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-accept-btn-handler {\\n  margin-right: 0;\\n}\\n\\n#onetrust-consent-sdk\\n  #onetrust-banner-sdk\\n  #onetrust-pc-btn-handler.cookie-setting-link {\\n  background-color: #ffffff;\\n  border: 2px solid #f3f3f3; /* same colour as bg to act as padding between focus border and button */\\n  border-radius: 8px; /* divided by border width to make border radius 4 */\\n  font-family: Interstate, \\\"Lucida Grande\\\", \\\"Lucida Sans Unicode\\\", \\\"Lucida Sans\\\",\\n    Garuda, Verdana, Tahoma, sans-serif;\\n  font-size: 14px;\\n  font-weight: normal;\\n  line-height: 20px;\\n  margin-top: 0;\\n  margin-bottom: 0;\\n  margin-right: 16px;\\n  padding: 12px 30px;\\n  text-decoration: none;\\n}\\n\\n#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-pc-btn-handler {\\n  background-color: #ffffff;\\n  border: 2px solid #f3f3f3; /* same colour as bg to act as padding between focus border and button */\\n  border-radius: 8px; /* divided by border width to make border radius 4 */\\n  font-family: Interstate, \\\"Lucida Grande\\\", \\\"Lucida Sans Unicode\\\", \\\"Lucida Sans\\\",\\n    Garuda, Verdana, Tahoma, sans-serif;\\n  font-size: 14px;\\n  font-weight: normal;\\n  line-height: 20px;\\n  margin-top: 0;\\n  margin-bottom: 0;\\n  margin-right: 0;\\n  padding: 12px 30px;\\n  text-decoration: none;\\n  width: 100%;\\n}\\n\\n#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-accept-btn-handler:focus,\\n#onetrust-consent-sdk\\n  #onetrust-banner-sdk\\n  #onetrust-pc-btn-handler.cookie-setting-link:focus {\\n  border-radius: 8px;\\n  box-shadow: 0 0 0 2px rgba(102, 102, 102, 0.75); /* actually a border */\\n  opacity: 1;\\n  outline: none;\\n}\\n\\n#onetrust-consent-sdk\\n  #onetrust-banner-sdk:not(.ot-iab-2)\\n  #onetrust-group-container {\\n  display: flex;\\n  align-items: center;\\n  flex-grow: 1;\\n  margin-right: 20px;\\n}\\n\\n@media only screen and (max-width: 769px) {\\n  #onetrust-consent-sdk #onetrust-banner-sdk .ot-sdk-container {\\n    margin: 0;\\n    padding: 0;\\n    width: 100%;\\n  }\\n\\n  #onetrust-consent-sdk #onetrust-banner-sdk .ot-sdk-row {\\n    flex-direction: column;\\n    max-width: unset;\\n    padding: 24px 0;\\n  }\\n\\n  #onetrust-consent-sdk\\n    #onetrust-banner-sdk:not(.ot-iab-2)\\n    #onetrust-group-container {\\n    margin-bottom: 16px;\\n    padding-left: 16px;\\n    padding-right: 16px;\\n    width: 100%;\\n  }\\n\\n  /* Extra selectors because OneTrust adds odd classes if website is access from mobile */\\n  #onetrust-consent-sdk\\n    #onetrust-banner-sdk:not(.ot-iab-2)\\n    #onetrust-button-group-parent,\\n  #onetrust-consent-sdk\\n    #onetrust-banner-sdk.vertical-align-content\\n    #onetrust-button-group-parent,\\n  #onetrust-consent-sdk\\n    #onetrust-banner-sdk:not(.ot-iab-2).vertical-align-content\\n    #onetrust-consent-sdk\\n    #onetrust-button-group-parent,\\n  #onetrust-consent-sdk\\n    #onetrust-banner-sdk.ot-buttons-fw:not(.ot-iab-2)\\n    #onetrust-consent-sdk\\n    #onetrust-button-group-parent {\\n    margin-left: 0;\\n    max-width: unset;\\n    padding: 0 16px;\\n    width: 100%;\\n  }\\n\\n  #onetrust-consent-sdk #onetrust-banner-sdk #onetrust-button-group {\\n    align-items: center;\\n    margin-top: 0;\\n    width: 100%;\\n  }\\n\\n  /* Accept All Cookies button - extra selectors because OneTrust adds odd classes if website is access from mobile */\\n  #onetrust-consent-sdk\\n    #onetrust-banner-sdk.ot-buttons-fw:not(.ot-iab-2)\\n    #onetrust-button-group\\n    button:last-of-type {\\n    width: 100%;\\n  }\\n\\n  /* Extra selectors because OneTrust adds odd classes if website is access from mobile */\\n  #onetrust-consent-sdk\\n    #onetrust-banner-sdk.ot-buttons-fw:not(.ot-iab-2)\\n    #onetrust-consent-sdk\\n    #onetrust-button-group\\n    button,\\n  #onetrust-consent-sdk\\n    #onetrust-banner-sdk\\n    #onetrust-pc-btn-handler.cookie-setting-link {\\n    margin-right: 0;\\n    margin-bottom: 8px;\\n    width: 100%;\\n  }\\n\\n  #onetrust-consent-sdk\\n    #onetrust-banner-sdk\\n    :is(#onetrust-accept-btn-handler, #onetrust-reject-all-handler) {\\n    margin-bottom: 8px;\\n  }\\n}\\n\\n@media only screen and (min-width: 1024px) and (max-width: 1064px) {\\n  #onetrust-banner-sdk.ot-iab-2\\n    #onetrust-group-container\\n    #onetrust-policy\\n    .ot-dpd-container {\\n    width: 44%;\\n  }\\n}\\n\\n@media only screen and (max-width: 769px) {\\n  #onetrust-banner-sdk.ot-iab-2 #onetrust-group-container {\\n    padding: 0 20px;\\n  }\\n}\\n\\n@media only screen and (max-width: 1080px) {\\n  /* Extra selectors because OneTrust adds odd classes if website is access from mobile */\\n  #onetrust-consent-sdk\\n    #onetrust-banner-sdk.ot-buttons-fw:not(.ot-iab-2)\\n    #onetrust-button-group\\n    button,\\n  #onetrust-consent-sdk\\n    #onetrust-banner-sdk\\n    #onetrust-pc-btn-handler.cookie-setting-link {\\n    margin-right: 0;\\n    margin-bottom: 8px;\\n    width: 100%;\\n  }\\n\\n  #onetrust-consent-sdk #onetrust-banner-sdk #onetrust-accept-btn-handler,\\n  #onetrust-consent-sdk\\n    #onetrust-banner-sdk.ot-buttons-fw:not(.ot-iab-2)\\n    #onetrust-consent-sdk\\n    #onetrust-button-group\\n    button:last-of-type {\\n    margin: 0;\\n    margin-bottom: 8px;\\n    width: 100%;\\n  }\\n}\\n\\n@media only screen and (max-width: 769px) {\\n  #onetrust-consent-sdk #onetrust-banner-sdk #onetrust-button-group {\\n    min-width: 180px;\\n  }\\n}\\n\",\"PCCustomCSS\":\"/* @@@ Custom GDPR preference center css: start @@@ */\\n/* Please refer to v2/docs/onetrust.md */\\n#onetrust-consent-sdk #onetrust-pc-sdk {\\n  font-family: Interstate, 'Lucida Grande', 'Lucida Sans Unicode', 'Lucida Sans',\\n    Garuda, Verdana, Tahoma, sans-serif;\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-pc-header {\\n  height: 36px;\\n  padding: 16px 24px;\\n  border-bottom: none;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk .ot-pc-header {\\n    padding: 16px;\\n  }\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-pc-footer {\\n  border-top: none;\\n  max-height: 76px;\\n}\\n\\n/* Footer container */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-btn-container {\\n  padding: 16px 24px;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk .ot-btn-container {\\n    padding: 16px;\\n  }\\n}\\n\\n/* Main container */\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-pc-lst {\\n  top: 62px;\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-pc-content {\\n  padding: 0 24px;\\n  margin: 0;\\n  width: 100%;\\n  top: 68px;\\n  bottom: 76px;\\n  box-sizing: border-box;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk #ot-pc-content {\\n    padding: 0 16px;\\n  }\\n}\\n\\n/* Back chevron in header */\\n#onetrust-consent-sdk #onetrust-pc-sdk .back-btn-handler {\\n  position: absolute;\\n  top: -45px;\\n  background-image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMzYiIGhlaWdodD0iMzYiIHZpZXdCb3g9IjAgMCAzNiAzNiIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjM2IiBoZWlnaHQ9IjM2IiByeD0iMTgiIGZpbGw9IiNGM0YzRjMiLz4KPHBhdGggZD0iTTIyIDI3TDEyIDE4TDIyIDkiIHN0cm9rZT0iYmxhY2siIHN0cm9rZS13aWR0aD0iMS42Ii8+Cjwvc3ZnPgo=);\\n  width: 36px;\\n  height: 36px;\\n  background-size: 36px;\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk .back-btn-handler svg {\\n  display: none;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk #ot-back-arw {\\n    margin-left: 0;\\n  }\\n}\\n\\n/* Hide back chevron if filter modal is open on mobile */\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk.ot-shw-fltr .back-btn-handler {\\n    display: none;\\n  }\\n}\\n\\n/* Close button in header */\\n#onetrust-consent-sdk #onetrust-pc-sdk #close-pc-btn-handler.ot-close-icon {\\n  background-image: url(data:image/svg+xml;base64,);\\n  width: 36px;\\n  height: 36px;\\n  background-size: 36px;\\n  right: 24px;\\n  top: 16px;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk #close-pc-btn-handler.ot-close-icon {\\n    right: 16px;\\n  }\\n}\\n\\n/* \\\"Cookie Manager\\\" */\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-pc-title {\\n  font-size: 17px;\\n  line-height: 24px;\\n  margin-bottom: 20px;\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-pc-desc {\\n  font-size: 14px;\\n  font-weight: 100;\\n  line-height: 20px;\\n  margin-bottom: 20px;\\n}\\n\\n/* \\\"Read more about our Cookie Policy\\\" link */\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-pc-desc .privacy-notice-link {\\n  margin-top: 10px;\\n  display: inline-block;\\n  color: #3370dd;\\n  text-decoration: none;\\n  font-weight: 100;\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-pc-desc .privacy-notice-link:hover {\\n  opacity: 0.7;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk button {\\n    max-width: unset;\\n    width: 100%;\\n  }\\n}\\n\\n/* Accept All Cookies button */\\n#onetrust-consent-sdk #onetrust-pc-sdk #accept-recommended-btn-handler {\\n  border: 2px solid #ffffff; /* same colour as bg to act as padding between focus border and button */\\n  border-radius: 8px; /* divided by border width to make border radius 4 */\\n  font-size: 14px;\\n  font-weight: normal;\\n  height: 44px;\\n  line-height: 0; /* vertically centre text in button */\\n  margin-bottom: 0;\\n  margin-top: 0;\\n  padding: 12px 30px;\\n  white-space: nowrap;\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk #accept-recommended-btn-handler:focus {\\n  border-radius: 8px;\\n  box-shadow: 0 0 0 2px rgba(102, 102, 102, 0.75); /* actually a border */\\n  opacity: 1;\\n  outline: none;\\n}\\n\\n/* Confirm My Choices button */\\n#onetrust-consent-sdk #onetrust-pc-sdk .save-preference-btn-handler,\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-btn-container button {\\n  border-radius: 8px; /* divided by border width to make border radius 4 */\\n  font-size: 14px;\\n  font-weight: normal;\\n  height: 44px;\\n  letter-spacing: 0.01em;\\n  line-height: 0; /* vertically centre text in button */\\n  margin-bottom: 0;\\n  margin-top: 0;\\n  padding: 12px 30px;\\n  white-space: nowrap;\\n  margin: 0;\\n}\\n\\n/* Confirm My Choices button - some super random specific targeting */\\n#onetrust-consent-sdk\\n  #onetrust-pc-sdk\\n  button:not(#clear-filters-handler):not(.ot-close-icon):not(#filter-btn-handler):not(.ot-remove-objection-handler):not(.ot-obj-leg-btn-handler):not([aria-expanded]):not(.ot-link-btn) {\\n  border: 2px solid #ffffff; /* same colour as bg to act as padding between focus border and button */\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk .save-preference-btn-handler:focus,\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-btn-container button:focus {\\n  border-radius: 8px;\\n  box-shadow: 0 0 0 2px rgba(102, 102, 102, 0.75); /* actually a border */\\n  opacity: 1;\\n  outline: none;\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-cat-grp {\\n  margin-top: 40px;\\n}\\n\\n/* \\\"Manage Consent Preferences */\\n#onetrust-consent-sdk #onetrust-pc-sdk h3#ot-pc-title,\\n#onetrust-consent-sdk #onetrust-pc-sdk h3#ot-category-title {\\n  font-size: 16px;\\n  line-height: 24px;\\n  font-weight: normal;\\n}\\n\\n/* Accordion container */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-accordion-layout.ot-cat-item,\\n#onetrust-consent-sdk\\n  #onetrust-pc-sdk\\n  .ot-accordion-layout.ot-cat-item:first-of-type {\\n  border: none;\\n}\\n\\n/* Accordion titles */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-accordion-layout .ot-cat-header {\\n  font-size: 14px;\\n  line-height: 20px;\\n  font-weight: 100;\\n}\\n\\n/* Accordion row outer container */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-accordion-layout .ot-acc-hdr {\\n  padding-left: 0;\\n  padding-right: 0;\\n  width: 100%;\\n}\\n\\n/* Accordion row icon left */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-plus-minus span {\\n  display: none;\\n}\\n\\n/* Accordion row icon chevron down */\\n#onetrust-consent-sdk\\n  #onetrust-pc-sdk\\n  button[aria-expanded='false']\\n  + .ot-acc-hdr\\n  .ot-plus-minus:before {\\n  content: '';\\n  background-image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTQiIGhlaWdodD0iOSIgdmlld0JveD0iMCAwIDE0IDkiIGZpbGw9Im5vbmUiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+CjxwYXRoIGQ9Ik0xMyAxTDcgNy42NjY2N0wxIDEiIHN0cm9rZT0iYmxhY2siIHN0cm9rZS13aWR0aD0iMS42Ii8+Cjwvc3ZnPgo=);\\n  background-position: center;\\n  background-repeat: no-repeat;\\n  width: 100%;\\n  height: 100%;\\n  display: block;\\n}\\n\\n/* Accordion row icon chevron up */\\n#onetrust-consent-sdk\\n  #onetrust-pc-sdk\\n  button[aria-expanded='true']\\n  + .ot-acc-hdr\\n  .ot-plus-minus:before {\\n  content: '';\\n  background-image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTQiIGhlaWdodD0iMTAiIHZpZXdCb3g9IjAgMCAxNCAxMCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHBhdGggZD0iTTEgOC42NjY2M0w3IDEuOTk5OTZMMTMgOC42NjY2MyIgc3Ryb2tlPSJibGFjayIgc3Ryb2tlLXdpZHRoPSIxLjYiLz4KPC9zdmc+Cg==);\\n  background-position: center;\\n  background-repeat: no-repeat;\\n  width: 100%;\\n  height: 100%;\\n  display: block;\\n}\\n\\n/* Accordion row \\\"Always Active */\\n#onetrust-consent-sdk\\n  #onetrust-pc-sdk\\n  .ot-accordion-layout\\n  h4\\n  ~ .ot-always-active {\\n  color: #000000;\\n  font-weight: normal;\\n  right: 0;\\n}\\n\\n/* Accordion row toggle switch */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-accordion-layout h4 ~ .ot-tgl {\\n  right: 0;\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk input[type='checkbox']:focus {\\n  outline: 2px solid rgba(102, 102, 102, 0.75);\\n  border: none;\\n}\\n\\n/* Accordion row container open */\\n#onetrust-consent-sdk\\n  #onetrust-pc-sdk\\n  .ot-cat-item\\n  > button[aria-expanded='true']\\n  ~ .ot-acc-grpcntr {\\n  padding-bottom: 16px;\\n}\\n\\n/* Accordion row description container */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-accordion-layout .ot-acc-grpdesc {\\n  padding: 16px 24px;\\n  margin: 0;\\n  font-size: 14px;\\n  line-height: 20px;\\n  font-weight: 100;\\n  width: unset;\\n}\\n\\n/* \\\"Cookie Details\\\" container */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-accordion-layout .ot-hlst-cntr {\\n  box-sizing: border-box;\\n  width: 100%;\\n  margin-bottom: 0;\\n  padding: 0 24px;\\n}\\n\\n#onetrust-consent-sdk\\n  #onetrust-pc-sdk\\n  .ot-accordion-layout\\n  .ot-hlst-cntr:last-child {\\n  margin-bottom: 0;\\n}\\n\\n/* \\\"Cookie Details\\\" */\\n#onetrust-consent-sdk #onetrust-pc-sdk .category-host-list-handler {\\n  color: #3370dd;\\n  font-size: 14px;\\n  line-height: 20px;\\n  font-weight: 100;\\n}\\n\\n/* \\\"Cookies List\\\" header container */\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-lst-title {\\n  margin: 10px 0 16px;\\n}\\n\\n/* \\\"Cookies List\\\" header */\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-lst-title span {\\n  font-size: 16px;\\n  line-height: 24px;\\n  font-weight: normal;\\n  margin: 0;\\n}\\n\\n/* Cookies list search and filter outer container */\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-pc-hdr {\\n  margin: 0 0 24px;\\n  padding: 0 24px;\\n  box-sizing: border-box;\\n  width: 100%;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk #ot-pc-hdr {\\n    padding: 0 16px;\\n  }\\n}\\n\\n/* Cookies list search and filter inner container */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-lst-subhdr {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n}\\n\\n/* Cookies list accordions wrap */\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-lst-cnt {\\n  margin: 0;\\n  max-height: calc(100% - 100px);\\n  min-width: unset;\\n  padding: 2px 24px 0; /* 2px accounts for a11y outline width */\\n  width: unset;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk #ot-lst-cnt {\\n    padding: 2px 16px 0; /* 2px accounts for a11y outline width */\\n    max-height: calc(100% - 76px);\\n  }\\n}\\n\\n/* Cookies list accordion all rows container */\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-host-lst .ot-acc-txt {\\n  width: calc(\\n    100% - 4px\\n  ); /* so it doesn't overlap focus bounding box in chrome */\\n  margin-left: auto;\\n  margin-right: auto;\\n}\\n\\n/* Cookies list accordion row container */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-host-info {\\n  padding: 24px;\\n  margin-bottom: 16px;\\n  width: 100%;\\n  box-sizing: border-box;\\n}\\n\\n/* Cookies list accordion text */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-host-opt li > div div {\\n  font-weight: 100;\\n  font-size: 12px;\\n  line-height: 20px;\\n  padding: 0;\\n}\\n\\n/* Cookies list accordion row gutter */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-host-opt li > div + div > div {\\n  margin-top: 24px;\\n}\\n\\n/* Cookies list accordion text left column */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-host-opt li > div div:nth-child(1) {\\n  width: 25%;\\n}\\n\\n/* Cookies list accordion text right column */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-host-opt li > div div:nth-child(2) {\\n  width: 75%;\\n}\\n\\n/* Search bar container */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-search-cntr {\\n  display: inline-block;\\n  flex: 0 1 78%;\\n  float: none;\\n  margin-right: 24px;\\n  width: unset;\\n}\\n\\n/* Search bar */\\n#onetrust-consent-sdk #onetrust-pc-sdk #vendor-search-handler {\\n  background-color: #f3f3f3;\\n  border-radius: 4px;\\n  border: none;\\n  color: #000000;\\n  float: none;\\n  font-size: 14px;\\n  font-weight: 100;\\n  height: 54px;\\n  line-height: 20px;\\n  margin-left: 0;\\n  padding-bottom: 16px;\\n  padding-left: 45px;\\n  padding-right: 16px;\\n  padding-top: 16px;\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-pc-hdr input::placeholder {\\n  color: #757575;\\n  font-style: normal;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk #vendor-search-handler {\\n    padding-top: 8px;\\n    padding-bottom: 8px;\\n    height: 36px;\\n  }\\n}\\n\\n/* Search bar icon */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-search-cntr > svg {\\n  right: unset;\\n  height: 54px;\\n  left: 16px;\\n  float: none;\\n  top: 0;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk .ot-search-cntr > svg {\\n    height: 36px;\\n  }\\n}\\n\\n/* No results text container */\\n#onetrust-consent-sdk #onetrust-pc-sdk #no-results {\\n  margin: 0;\\n}\\n\\n/* No results text */\\n#onetrust-consent-sdk #onetrust-pc-sdk #no-results p {\\n  font-size: 14px;\\n  font-weight: 100;\\n  line-height: 20px;\\n  margin: 0;\\n}\\n\\n/* Filter button container */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-fltr-cntr {\\n  float: none;\\n  width: unset;\\n  right: unset;\\n  display: inline-block;\\n  height: 58px;\\n  flex: 0 0 22%;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk .ot-fltr-cntr {\\n    height: 40px;\\n    flex-basis: 23%;\\n    flex-shrink: 0;\\n  }\\n}\\n\\n/* Filter button */\\n#onetrust-consent-sdk #onetrust-pc-sdk #filter-btn-handler {\\n  background-color: #f3f3f3;\\n  border: 2px solid #ffffff !important;\\n  border-radius: 6px;\\n  padding: 16px 24px;\\n  width: 100%;\\n  height: 100%;\\n  word-break: keep-all;\\n  color: #000000;\\n  transition: none;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk #filter-btn-handler {\\n    padding: 8px 24px;\\n  }\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk #filter-btn-handler:hover {\\n  background: rgba(0, 0, 0, 0.2);\\n  opacity: 1;\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk #filter-btn-handler:focus {\\n  border-radius: 8px;\\n  box-shadow: 0 0 0 2px rgba(102, 102, 102, 0.75); /* actually a border */\\n  opacity: 1;\\n  outline: none;\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk #filter-btn-handler svg {\\n  display: none;\\n}\\n\\n/* Filter button text */\\n#onetrust-consent-sdk #onetrust-pc-sdk #filter-btn-handler:after {\\n  content: 'Filters';\\n  font-weight: 100;\\n  font-size: 14px;\\n  line-height: 20px;\\n}\\n\\n/* Filter button open state */\\n#onetrust-consent-sdk #ot-anchor {\\n  display: none !important; /* overwriting inline style */\\n}\\n\\n/* Filter modal main container */\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-fltr-modal {\\n  right: 27px;\\n  position: absolute;\\n  z-index: 2147483646;\\n  width: unset;\\n  box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);\\n  border: 1px solid #d8d8d8;\\n  border-radius: 4px;\\n  top: 102px;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk #ot-fltr-modal {\\n    top: 0; /* full screen overlay */\\n    left: 0;\\n    right: 0;\\n    width: 100vw;\\n    height: calc(100vh - 62px);\\n    border: none;\\n    border-radius: unset;\\n    box-shadow: none;\\n  }\\n\\n  #onetrust-consent-sdk #onetrust-pc-sdk #ot-fltr-modal:after {\\n    content: 'Filters';\\n    position: absolute;\\n    top: 10px;\\n    left: 16px;\\n    width: 100%;\\n    font-family: Interstate, 'Lucida Grande', 'Lucida Sans Unicode',\\n      'Lucida Sans', Garuda, Verdana, Tahoma, sans-serif;\\n    font-size: 16px;\\n    line-height: 24px;\\n    color: #000000;\\n  }\\n}\\n\\n/* Filter modal container */\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-fltr-cnt {\\n  font-family: Interstate, 'Lucida Grande', 'Lucida Sans Unicode', 'Lucida Sans',\\n    Garuda, Verdana, Tahoma, sans-serif;\\n  padding: 16px;\\n  left: unset;\\n  right: unset;\\n  background: #ffffff;\\n  margin: 0;\\n  width: 262px;\\n  height: unset;\\n  box-sizing: border-box;\\n  max-height: unset;\\n  position: relative;\\n  z-index: unset;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk #ot-fltr-cnt {\\n    width: 100%;\\n    height: 100%;\\n    max-width: unset;\\n    top: 0;\\n    padding: 56px 16px 16px; /* top padding accounts for pseudo \\\"Filters\\\" text */\\n  }\\n}\\n\\n/* Filter modal container */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-fltr-scrlcnt {\\n  overflow: visible;\\n  margin-top: 16px;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk .ot-fltr-scrlcnt {\\n    display: flex;\\n    flex-direction: column;\\n    justify-content: space-between;\\n    height: calc(100% - 38px);\\n    max-height: unset;\\n  }\\n}\\n\\n/* Filter modal options */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-fltr-opt {\\n  margin: 0;\\n  width: 100%;\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-chkbox label {\\n  font-weight: 100;\\n  padding-left: 24px;\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk #ot-fltr-modal .ot-label-txt {\\n  font-size: 14px;\\n  font-weight: 100;\\n  line-height: 20px;\\n}\\n\\n/* Filter modal option checkbox */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-chkbox label::before {\\n  width: 14px;\\n  height: 14px;\\n  border: none;\\n  top: 3px;\\n  left: 0;\\n  background-image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTYiIGhlaWdodD0iMTYiIHZpZXdCb3g9IjAgMCAxNiAxNiIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3QgeD0iMSIgeT0iMSIgd2lkdGg9IjE0IiBoZWlnaHQ9IjE0IiByeD0iMiIgc3Ryb2tlPSIjNzU3NTc1IiBzdHJva2Utb3BhY2l0eT0iMC43NSIvPgo8L3N2Zz4K);\\n  background-position: center;\\n  background-repeat: no-repeat;\\n  border-radius: 2px;\\n  background-color: #ffffff;\\n}\\n\\n#onetrust-consent-sdk\\n  #onetrust-pc-sdk\\n  .ot-chkbox\\n  input:checked\\n  ~ label::before {\\n  background-image: url(data:image/svg+xml;base64,);\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-chkbox label::after {\\n  content: none !important; /* overwrite OneTrust's checkbox styles */\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-fltr-opt + .ot-fltr-opt {\\n  margin-top: 16px;\\n}\\n\\n/* Filter modal buttons */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-fltr-btns {\\n  display: flex;\\n  flex-direction: row-reverse;\\n  justify-content: space-between;\\n  margin: 24px 0 0;\\n  width: 100%;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk .ot-fltr-btns {\\n    margin: 0;\\n  }\\n}\\n\\n/* Filter modal Clear Filters button */\\n#onetrust-consent-sdk #onetrust-pc-sdk #clear-filters-handler {\\n  float: none;\\n  font-size: 14px;\\n  font-weight: 100;\\n  line-height: 20px;\\n  margin: 0;\\n  max-width: unset;\\n  padding: 0;\\n  text-align: right;\\n  width: 100%;\\n}\\n\\n@media only screen and (max-width: 600px) {\\n  #onetrust-consent-sdk #onetrust-pc-sdk #clear-filters-handler {\\n    text-align: left;\\n  }\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk #clear-filters-handler {\\n  color: #3370dd;\\n}\\n\\n/* Filter modal Apply button */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-fltr-btns #filter-apply-handler {\\n  font-weight: 100;\\n  border: 2px solid #ffffff;\\n  border-radius: 8px;\\n  margin: 0;\\n  height: 44px;\\n  padding: 12px 16px;\\n  font-size: 14px;\\n  line-height: 0;\\n  letter-spacing: 0;\\n  width: 100%;\\n}\\n\\n/* Filter modal Cancel button */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-fltr-btns #filter-cancel-handler {\\n  border: 2px solid #ffffff;\\n  border-radius: 8px;\\n  background-color: #f3f3f3 !important; /* they wouldn't */\\n  color: #000000 !important; /* budge otherwise, sorry :-( */\\n  font-weight: 100;\\n  margin: 0;\\n  margin-right: 16px;\\n  height: 44px;\\n  padding: 12px 16px;\\n  font-size: 14px;\\n  line-height: 0;\\n  letter-spacing: 0;\\n  width: 100%;\\n}\\n\\n#onetrust-consent-sdk\\n  #onetrust-pc-sdk\\n  .ot-fltr-btns\\n  #filter-apply-handler:focus,\\n#onetrust-consent-sdk\\n  #onetrust-pc-sdk\\n  .ot-fltr-btns\\n  #filter-cancel-handler:focus {\\n  border-radius: 8px;\\n  box-shadow: 0 0 0 2px rgba(102, 102, 102, 0.75); /* actually a border */\\n  opacity: 1;\\n  outline: none;\\n}\\n\\n/* \\\"View Cookies\\\" */\\n#onetrust-consent-sdk\\n  #onetrust-pc-sdk\\n  #ot-host-lst\\n  .ot-acc-hdr\\n  .ot-host-expand {\\n  display: none;\\n}\\n\\n/* Cookies and vendors list accordion row */\\n#onetrust-consent-sdk #onetrust-pc-sdk ul li {\\n  padding: 16px 0;\\n  border-bottom: none;\\n}\\n\\n#onetrust-consent-sdk #onetrust-pc-sdk ul li.ot-ven-pur ul li {\\n  padding: 0;\\n  border-bottom: none;\\n}\\n\\n/* Cookies list accordion left icon */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-host-item .ot-plus-minus {\\n  top: unset;\\n}\\n\\n/* Cookies list accordion title */\\n#onetrust-consent-sdk #onetrust-pc-sdk h3.ot-host-name {\\n  font-weight: 100;\\n  font-size: 14px;\\n  line-height: 20px;\\n  color: #000000;\\n}\\n\\n/* Focus outlines */\\n#onetrust-consent-sdk #onetrust-pc-sdk .ot-sdk-button:focus,\\n#onetrust-conse